@model DecisionViewModel;

@{
    ViewData["Title"] = "Home Page";
    Layout = "~/Views/Shared/_LayoutNav.cshtml";
}
<head>
    <link rel="stylesheet" href="~/css/decision.css" />    
</head>
<body>
    <div class="decision-container">        
        <div class="text-center dec-text">
            <h2>@Model.Decision</h2>
        </div>
        <div class="text-center app-score-text">
            @{ 
                string score = $"{double.Parse(Model.Score):f2}";
            }
            <h3>Application score: @score</h3>           
        </div>
    </div>
    <div>
        <button class="btn btn-primary again-btn" type="button" onclick="window.location.href='/Home/SingleProcessing'">Again</button>
    </div>
</body>