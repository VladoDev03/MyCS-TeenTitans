@{
    ViewData["Title"] = "Home Page";
    Layout = "~/Views/Shared/_LayoutNav.cshtml";
}
<head>
    <link rel="stylesheet" href="~/css/singleProcessing.css" />
    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script type="text/javascript" src="~/js/singleProcessing.js"></script>
</head>
<body>
    <form id="regForm" asp-action="DecisionNewClient" asp-controller="Home">
        <!-- One "tab" for each step in the form: -->

        <div class="tab">
            <div class="field-container">
                <div>Occupation code</div>
                <div class="input-group">
                    <select class="custom-select" id="input-group-select-occupation-code" name="occCode">
                        <option selected>Choose...</option>
                        <option value="1">Other</option>
                        <option value="2">Pensioner</option>
                        <option value="3">Self-employed</option>
                        <option value="4">Employee</option>
                    </select>
                    <div class="input-group-append">
                        <label class="input-group-text" for="input-group-select-occupation-code">Options</label>
                    </div>
                </div>
                <div class="message" id="occupation-code-error-message">Occupation code is required!</div>
            </div>
            <div class="field-container">
                <div>Current deliquency status: </div>
                <div class="input-group">
                    <select class="custom-select" id="input-group-select-current-deliquency-status" name="currDelStatus">
                        <option selected>Choose...</option>
                        <option value="1">Zero</option>
                        <option value="2">One</option>
                        <option value="3">Two</option>
                        <option value="4">Three</option>
                        <option value="5">Four</option>
                        <option value="6">Five</option>
                        <option value="7">Six</option>
                        <option value="8">More than six</option>
                    </select>
                    <div class="input-group-append">
                        <label class="input-group-text" for="input-group-select-current-deliquency-status">Options</label>
                    </div>
                </div>
                <div class="message" id="current-deliquency-status-error-message">Current deliquency status is required!</div>
            </div>
            <div class="field-container">
                <div>Time with Bank: </div>
                <input id="time-with-bank" placeholder="Time with Bank..." oninput="this.className = ''" name="timeWBank">
                <div class="message" id="time-with-bank-error-message">Time with Bank is required!</div>
            </div>
        </div>
       
        <div class="tab">
            <div class="field-container">
                <div>Bureau score: </div>
                <input id="bureau-score" placeholder="Bureau score..." oninput="this.className = ''" name="bureauScore">
                <div class="message" id="bureau-score-error-message">Bureau score is required!</div>
            </div>
            <div class="field-container">
                <div>GB Flag: </div>
                <input id="gb-flag" placeholder="GB Flag..." oninput="this.className = ''" name="gbFlag">
                <div class="message" id="gb-flag-error-message">GB Flag is required!</div>
            </div>
            <div class="field-container">
                <div>Loan to income: </div>
                <input id="loan-to-income" placeholder="Loan to income..." oninput="this.className = ''" name="loanToIncome">
                <div class="message" id="loan-to-income-error-message">Loan to income is required!</div>
            </div>
        </div>
        <div class="btn-form">
            <div class="btn-next-previous">
                <button class="btn btn-primary previous-btn" type="button" id="prevBtn" onclick="nextPrev(-1)">Previous</button>
                <button class="btn btn-primary next-btn" type="button" id="nextBtn" onclick="nextPrev(1)">Next</button>
            </div>
        </div>

        <!-- Circles which indicates the steps of the form: -->
        <div class="step-container">
            <div class="stepper">
                <span class="step"></span>
                <span class="step"></span>
               
                <!--<span class="step"></span>-->
            </div>
        </div>

    </form>
</body>