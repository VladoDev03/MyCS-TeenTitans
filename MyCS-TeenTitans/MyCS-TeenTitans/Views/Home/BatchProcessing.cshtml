@{
    ViewData["Title"] = "Home Page";
    Layout = "~/Views/Shared/_LayoutNav.cshtml";
}
<head>
    <link href="/css/batchProcessing.css" rel="stylesheet">
    <script src="https://kit.fontawesome.com/b99e675b6e.js"></script>
    <script type="text/javascript" src="~/js/batchProcessing.js"></script>
</head>

<title>Batch Processing</title>
<body>
    <div class="bg-light upload-form">
        <div class="container-sm shadow-sm bg-white py-4 upload-container ">
            <h2 class="text-center">Upload file:</h2>
            <form asp-action="MultyCreateUI" asp-controller="Processing" method="POST" id="upload">
                <div>
                    <h6>File name:</h6>
                </div>
                <div>
                    <input type="text" name="path" class="form-control" id="file-name" placeholder="wwwroot/FileName.csv">
                </div>                
                <div class="upload">
                    <button type="submit" onclick="Message()" class="upload-btn btn">
                        <i class="fas fa-file-upload"></i>  Upload
                    </button>
                </div>
                <div class="text-upl">
                    The directory where the file is saved:<br />
                    <div class="name-directory">
                        <i class="fas fa-folder"></i> wwwroot
                    </div>
                </div>
            </form>
        </div>
    </div>
</body>