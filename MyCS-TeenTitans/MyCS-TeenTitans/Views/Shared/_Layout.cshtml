<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MyCS_TeenTitans</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow ">
            <div class=" container ">
                <a class="navbar-brand logo" asp-area="" asp-controller="Home" asp-action="Index">My Credit Score - TeenTitans</a>
                                
            </div>
        </nav>
    </header>
    <div class="container-fluid main-cont">
        
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        
    </div>
    <footer class="border-top footer text-muted">
        <div class="foo-conteiner container">
            &copy; 2021 - MyCS_TeenTitans - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
